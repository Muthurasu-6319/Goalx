        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && isPositiveInt(data.amountPaise)
        && isStrictDate(data.date)
        && isPaymentMethod(data.paymentMethod)
        && isOptionalString(data, 'paidBy', 120)
        && isOptionalString(data, 'description', 1000)
        && isOptionalString(data, 'serviceId', 128)
        && isOptionalString(data, 'projectId', 128)
        && isOptionalString(data, 'attachmentUrl', 1000)
        && isOptionalString(data, 'attachmentName', 200)
        && isOptionalString(data, 'recurringTemplateId', 128)
        && (!('recurringMonth' in data) || data.recurringMonth == '' || isMonthString(data.recurringMonth))
        && isOptionalString(data, 'salaryRecordId', 128)
        && data.isDeleted is bool
