    function isValidAiArea(val) {
      return val is string
        && val in ['general', 'personal', 'finance', 'leads', 'projects', 'team', 'competition', 'gamification']
        && val.size() <= 30;
    }

    function isValidAiConversation(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'title', 'areaHint', 'lastMessagePreview',
          'messageCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'title', 'areaHint', 'lastMessagePreview',
          'messageCount', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && isValidAiArea(data.areaHint)
        && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300
        && isNonNegativeInt(data.messageCount) && data.messageCount <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
