    match /baselineReviews/{reviewId} {
      allow get: if isSignedIn() && isValidId(reviewId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(reviewId)
        && isValidBaselineReview(incoming())
        && incoming().createdAt == request.time
