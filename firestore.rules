    // -------------------------------------------------------------------------
    // Phase 5B Entity Validation Blueprints (Scorecards, Gaps & Progression)
    // -------------------------------------------------------------------------
    function isPriorityLevel(val) {
      return val is string && val in ['Low', 'Medium', 'High'] && val.size() <= 20;
    }

    function isValidScoreWeight(w) {
      return w is int && w >= 0 && w <= 100;
    }

    function isValidScoreWeightsMap(weights) {
      return weights is map
        && weights.keys().hasAll([
          'revenue_growth', 'client_acquisition', 'project_delivery',
          'service_portfolio', 'technology_innovation', 'portfolio_quality',
          'customer_reputation', 'digital_presence', 'team_operations', 'pricing_value'
        ])
        && weights.keys().hasOnly([
          'revenue_growth', 'client_acquisition', 'project_delivery',
          'service_portfolio', 'technology_innovation', 'portfolio_quality',
          'customer_reputation', 'digital_presence', 'team_operations', 'pricing_value'
        ])
        && isValidScoreWeight(weights.revenue_growth)
        && isValidScoreWeight(weights.client_acquisition)
        && isValidScoreWeight(weights.project_delivery)
        && isValidScoreWeight(weights.service_portfolio)
        && isValidScoreWeight(weights.technology_innovation)
        && isValidScoreWeight(weights.portfolio_quality)
        && isValidScoreWeight(weights.customer_reputation)
        && isValidScoreWeight(weights.digital_presence)
        && isValidScoreWeight(weights.team_operations)
        && isValidScoreWeight(weights.pricing_value)
        && (
          weights.revenue_growth + weights.client_acquisition + weights.project_delivery +
          weights.service_portfolio + weights.technology_innovation + weights.portfolio_quality +
          weights.customer_reputation + weights.digital_presence + weights.team_operations +
          weights.pricing_value
        ) == 100;
    }

    function isValidRatingScoreMap(rMap) {
      return rMap is map
        && rMap.keys().hasAll(['r1', 'r2', 'r3', 'r4', 'r5'])
        && rMap.keys().hasOnly(['r1', 'r2', 'r3', 'r4', 'r5'])
        && rMap.r1 is int && rMap.r1 >= 0 && rMap.r1 <= 100
        && rMap.r2 is int && rMap.r2 >= 0 && rMap.r2 <= 100
        && rMap.r3 is int && rMap.r3 >= 0 && rMap.r3 <= 100
        && rMap.r4 is int && rMap.r4 >= 0 && rMap.r4 <= 100
        && rMap.r5 is int && rMap.r5 >= 0 && rMap.r5 <= 100;
    }

    function isValidOwnMetric(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'metricKey', 'metricName', 'dimensionKey',
          'scorecardType', 'value', 'rating', 'score', 'sourceType',
          'dataStatus', 'lastVerifiedDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'metricKey', 'metricName', 'dimensionKey',
          'scorecardType', 'value', 'rating', 'score', 'sourceType',
          'sourceUrl', 'evidenceDescription', 'dataStatus', 'lastVerifiedDate',
          'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.metricKey is string && data.metricKey.size() >= 1 && data.metricKey.size() <= 80 && data.metricKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.metricName is string && data.metricName.size() >= 1 && data.metricName.size() <= 160
        && data.dimensionKey is string && data.dimensionKey.size() >= 1 && data.dimensionKey.size() <= 60
        && data.scorecardType is string && data.scorecardType in ['Market Presence', 'Business Performance'] && data.scorecardType.size() <= 30
        && data.value is string && data.value.size() >= 1 && data.value.size() <= 500
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.sourceType is string && data.sourceType in ['Calculated from GoalX data', 'User entered'] && data.sourceType.size() <= 40
        && (!('sourceUrl' in data) || data.sourceUrl == '' || isHttpUrl(data.sourceUrl))
        && isOptionalString(data, 'evidenceDescription', 1500)
        && isDataStatus(data.dataStatus)
        && (data.dataStatus != 'Verified' || ('sourceUrl' in data && isHttpUrl(data.sourceUrl)))
        && (data.lastVerifiedDate == '' || isStrictDate(data.lastVerifiedDate))
        && isOptionalString(data, 'notes', 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitorScoreConfig(data, configId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'weights', 'ratingScoreMap', 'minComparableMetrics',
          'minScoreAdvantage', 'minEvidenceCoveragePct', 'minConsecutiveMonths',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'weights', 'ratingScoreMap', 'minComparableMetrics',
