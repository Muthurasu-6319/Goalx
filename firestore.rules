        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.competitorId is string && isValidId(data.competitorId)
        && isMonthString(data.month)
        && isPositiveInt(data.version) && data.version <= 50
        && (reviewId == data.competitorId + '_' + data.month || reviewId.matches('^' + data.competitorId + '_' + data.month + '_v[0-9]+$'))
        && isStrictDate(data.reviewDate)
        && data.ownOverallScore is number && data.ownOverallScore >= 0 && data.ownOverallScore <= 100
        && data.competitorOverallScore is number && data.competitorOverallScore >= 0 && data.competitorOverallScore <= 100
        && data.scoreAdvantage is number && data.scoreAdvantage >= -100 && data.scoreAdvantage <= 100
        && data.ownMarketPresenceScore is number && data.ownMarketPresenceScore >= 0 && data.ownMarketPresenceScore <= 100
        && data.competitorMarketPresenceScore is number && data.competitorMarketPresenceScore >= 0 && data.competitorMarketPresenceScore <= 100
        && data.ownBusinessPerformanceScore is number && data.ownBusinessPerformanceScore >= 0 && data.ownBusinessPerformanceScore <= 100
        && data.competitorBusinessPerformanceScore is number && data.competitorBusinessPerformanceScore >= 0 && data.competitorBusinessPerformanceScore <= 100
        && isNonNegativeInt(data.comparableCount)
        && isNonNegativeInt(data.ownLeadsCount)
        && isNonNegativeInt(data.evidenceCoveragePct) && data.evidenceCoveragePct <= 100
        && data.eligibleForSurpass is bool
        && isOptionalString(data, 'summary', 1500)
        && data.createdAt is timestamp;
    }

    function isValidCompetitiveGap(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'title', 'businessImpact', 'priority',
          'estimatedEffort', 'suggestedActionOrigin', 'status', 'progressPct',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'title', 'description', 'linkedCompetitorIds',
          'linkedMetricKey', 'evidenceIds', 'businessImpact', 'priority',
          'estimatedEffort', 'suggestedAction', 'suggestedActionOrigin', 'deadline',
          'status', 'progressPct', 'convertedGoalId', 'convertedTaskId',
          'calendarEventId', 'templateKey', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && isOptionalString(data, 'description', 1500)
        && (!('linkedCompetitorIds' in data) || isStringList(data.linkedCompetitorIds, 20))
        && isOptionalString(data, 'linkedMetricKey', 80)
        && (!('evidenceIds' in data) || isStringList(data.evidenceIds, 20))
        && isPriorityLevel(data.businessImpact)
        && isPriorityLevel(data.priority)
        && isPriorityLevel(data.estimatedEffort)
        && isOptionalString(data, 'suggestedAction', 1500)
        && data.suggestedActionOrigin is string && data.suggestedActionOrigin in ['rule', 'AI-assisted'] && data.suggestedActionOrigin.size() <= 20
        && (!('deadline' in data) || data.deadline == '' || isStrictDate(data.deadline))
        && data.status is string && data.status in ['Open', 'In Progress', 'Done', 'Dismissed'] && data.status.size() <= 20
        && isNonNegativeInt(data.progressPct) && data.progressPct <= 100
        && isOptionalString(data, 'convertedGoalId', 128)
        && isOptionalString(data, 'convertedTaskId', 128)
        && isOptionalString(data, 'calendarEventId', 128)
        && isOptionalString(data, 'templateKey', 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitiveGoal(data, linkId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'gapId', 'targetType', 'title', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'gapId', 'targetType', 'goalId',
          'taskId', 'competitorId', 'title', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.gapId is string && isValidId(data.gapId)
        && data.targetType is string && data.targetType in ['goal', 'task'] && data.targetType.size() <= 20
        && linkId == data.gapId + '_' + data.targetType
        && isOptionalString(data, 'goalId', 128)
        && isOptionalString(data, 'taskId', 128)
        && isOptionalString(data, 'competitorId', 128)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidTaskItem(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'title', 'priority', 'status',
          'sourceType', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
