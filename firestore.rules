      allow update: if false;
      allow delete: if isSignedIn() && isValidId(reviewId) && isOwner(existing().ownerId);
    }

    match /activityLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidActivityLog(incoming())
        && incoming().createdAt == request.time
        && get(/databases/$(database)/documents/companies/$(incoming().companyId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
