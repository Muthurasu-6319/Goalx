        && (data.competitorId == '' || isValidId(data.competitorId))
        && data.action is string && data.action in ['research_competitor', 'analyze_website', 'discover_competitors', 'manual_research'] && data.action.size() <= 40
        && data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 200
        && (!('targetUrl' in data) || data.targetUrl == '' || isHttpUrl(data.targetUrl))
        && isStrictDate(data.runDate)
        && data.status is string && data.status in ['Completed', 'Unavailable', 'Failed'] && data.status.size() <= 20
        && data.groundingUsed is bool
        && isOptionalString(data, 'summary', 2000)
        && (!('searchQueries' in data) || isStringList(data.searchQueries, 10))
        && (!('sourceUrls' in data) || (data.sourceUrls is list && data.sourceUrls.size() <= 20 && (data.sourceUrls.size() == 0 || (data.sourceUrls.size() > 0 && data.sourceUrls[0] is string && data.sourceUrls[0].size() <= 500))))
        && isNonNegativeInt(data.findingsCount)
        && isNonNegativeInt(data.acceptedCount)
        && isNonNegativeInt(data.rejectedCount)
        && isOptionalString(data, 'errorMessage', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitorPendingFinding(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'researchRunId', 'competitorId', 'findingKind',
          'category', 'metricKey', 'metricName', 'proposedValue', 'evidenceDescription',
          'dataStatus', 'decision', 'aiAssisted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'researchRunId', 'competitorId', 'findingKind',
          'category', 'metricKey', 'metricName', 'proposedValue', 'sourceUrl',
          'sourceTitle', 'evidenceDescription', 'confidenceNote', 'dataStatus',
