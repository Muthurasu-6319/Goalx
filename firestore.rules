        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'greeting', 'overview', 'sections', 'riskFlags', 'topPriority',
          'mode', 'generatedAtIso', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(briefingId) && isOwner(existing().ownerId);
