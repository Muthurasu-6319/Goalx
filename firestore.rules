        && isValidId(gapId)
        && isValidCompetitiveGap(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/companies/$(incoming().companyId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(gapId)
        && isValidCompetitiveGap(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().companyId == existing().companyId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'linkedCompetitorIds', 'linkedMetricKey',
            'evidenceIds', 'businessImpact', 'priority', 'estimatedEffort',
            'suggestedAction', 'suggestedActionOrigin', 'deadline', 'status',
            'progressPct', 'calendarEventId', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'convertedGoalId', 'status', 'progressPct', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'convertedTaskId', 'status', 'progressPct', 'updatedAt'
          ])
        );
      allow delete: if isSignedIn() && isValidId(gapId) && isOwner(existing().ownerId);
    }

    match /competitiveGoals/{linkId} {
      allow get: if isSignedIn() && isValidId(linkId) && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
