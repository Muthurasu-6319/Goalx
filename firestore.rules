      allow get: if isSignedIn() && isValidId(eventId) && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(eventId)
        && isValidRewardEvent(incoming(), eventId)
        && incoming().createdAt == request.time
        && get(/databases/$(database)/documents/competitors/$(incoming().competitorId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/competitors/$(incoming().competitorId)).data.isActiveTarget == true
        && getAfter(/databases/$(database)/documents/competitors/$(incoming().competitorId)).data.status == 'Surpassed'
        && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().prevReviewId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().prevReviewId)).data.competitorId == incoming().competitorId
        && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().prevReviewId)).data.eligibleForSurpass == true
        && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().currReviewId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().currReviewId)).data.competitorId == incoming().competitorId
        && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().currReviewId)).data.eligibleForSurpass == true;
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 6B Collection Match Blocks (GoalX AI CEO, Briefings, Action Proposals)
    // -------------------------------------------------------------------------
    match /aiConversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(conversationId)
        && isValidAiConversation(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
