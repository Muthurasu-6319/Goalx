        && incoming().competitorId == existing().competitorId
        && incoming().metricKey == existing().metricKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'metricName', 'category', 'value', 'serviceOfferStatus', 'rating',
          'scorecardGroup', 'sourceUrl', 'evidenceDescription', 'dataStatus',
          'lastVerifiedDate', 'notes', 'updatedAt'
        ]);
