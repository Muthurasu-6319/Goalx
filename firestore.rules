        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.clientId is string && isValidId(data.clientId)
        && isOptionalString(data, 'serviceId', 128)
        && isOptionalString(data, 'serviceCategory', 160)
        && isOptionalString(data, 'assignedMemberId', 128)
        && isNonNegativeInt(data.budgetPaise)
        && data.status is string && data.status in ['Planning', 'In Progress', 'Completed', 'On Hold', 'Cancelled'] && data.status.size() <= 30
        && isStrictDate(data.startDate)
        && (!('dueDate' in data) || data.dueDate == '' || isStrictDate(data.dueDate))
        && isOptionalString(data, 'description', 2000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectPayment(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'projectId', 'clientId', 'amountPaise',
          'date', 'method', 'paymentType', 'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'projectId', 'clientId', 'amountPaise',
          'date', 'method', 'paymentType', 'invoiceNumber', 'notes',
          'isDeleted', 'deletedAt', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.projectId is string && isValidId(data.projectId)
        && data.clientId is string && isValidId(data.clientId)
        && isPositiveInt(data.amountPaise)
        && isStrictDate(data.date)
        && isPaymentMethod(data.method)
        && data.paymentType is string && data.paymentType in ['Advance', 'Partial', 'Final'] && data.paymentType.size() <= 20
        && isOptionalString(data, 'invoiceNumber', 60)
        && isOptionalString(data, 'notes', 1000)
        && data.isDeleted is bool
        && isOptionalString(data, 'deletedAt', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'name', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'name', 'role', 'department', 'email',
