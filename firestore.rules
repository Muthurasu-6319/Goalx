          'competitorMarketPresenceScore', 'ownBusinessPerformanceScore',
          'competitorBusinessPerformanceScore', 'comparableCount', 'ownLeadCount',
          'competitorLeadCount', 'equalCount', 'missingCount', 'scoreAdvantage',
          'aheadMetrics', 'behindMetrics', 'equalMetrics', 'missingMetrics',
