        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 120
        && isOptionalString(data, 'department', 120)
        && isOptionalString(data, 'email', 200)
        && isOptionalString(data, 'phone', 30)
        && data.status is string && data.status in ['Active', 'Inactive'] && data.status.size() <= 20
        && (!('joinedDate' in data) || data.joinedDate == '' || isStrictDate(data.joinedDate))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeamMemberPrivate(data, memberId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'memberId', 'baseSalaryPaise', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'memberId', 'baseSalaryPaise',
          'commissionRatePct', 'bankNotes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.memberId is string && isValidId(data.memberId) && data.memberId == memberId
        && isNonNegativeInt(data.baseSalaryPaise)
        && (!('commissionRatePct' in data) || data.commissionRatePct == null || (data.commissionRatePct is number && data.commissionRatePct >= 0 && data.commissionRatePct <= 100))
        && isOptionalString(data, 'bankNotes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOtherIncome(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'source', 'amountPaise', 'date',
          'method', 'isDeleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'source', 'clientId', 'amountPaise',
          'date', 'method', 'notes', 'isDeleted', 'deletedAt', 'createdAt', 'updatedAt'
