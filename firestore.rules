        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'title', 'category', 'amountPaise',
          'dayOfMonth', 'paymentMethod', 'paidBy', 'description',
          'serviceId', 'projectId', 'active', 'lastGeneratedMonth', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && isPositiveInt(data.amountPaise)
        && data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 28
        && isPaymentMethod(data.paymentMethod)
        && isOptionalString(data, 'paidBy', 120)
        && isOptionalString(data, 'description', 1000)
        && isOptionalString(data, 'serviceId', 128)
        && isOptionalString(data, 'projectId', 128)
        && data.active is bool
        && (!('lastGeneratedMonth' in data) || data.lastGeneratedMonth == '' || isMonthString(data.lastGeneratedMonth))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalaryRecord(data, salaryId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'memberId', 'month', 'baseSalaryPaise',
          'commissionPaise', 'commissionPctUsed', 'commissionOverride',
          'incentivePaise', 'deductionsPaise', 'netPayablePaise',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'memberId', 'month', 'baseSalaryPaise',
          'commissionPaise', 'commissionPctUsed', 'commissionOverride',
          'commissionNote', 'incentivePaise', 'deductionsPaise', 'netPayablePaise',
          'status', 'paidDate', 'paymentMethod', 'linkedExpenseId', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.memberId is string && isValidId(data.memberId)
        && isMonthString(data.month)
        && salaryId == data.memberId + '_' + data.month
        && isNonNegativeInt(data.baseSalaryPaise)
        && isNonNegativeInt(data.commissionPaise)
        && data.commissionPctUsed is number && data.commissionPctUsed >= 0 && data.commissionPctUsed <= 100
        && data.commissionOverride is bool
        && isOptionalString(data, 'commissionNote', 500)
        && isNonNegativeInt(data.incentivePaise)
        && isNonNegativeInt(data.deductionsPaise)
        && isNonNegativeInt(data.netPayablePaise)
        && data.status is string && data.status in ['Pending', 'Paid'] && data.status.size() <= 20
        && (!('paidDate' in data) || data.paidDate == '' || isStrictDate(data.paidDate))
        && (!('paymentMethod' in data) || data.paymentMethod == '' || isPaymentMethod(data.paymentMethod))
        && isOptionalString(data, 'linkedExpenseId', 160)
        && isOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBudget(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'budgetType', 'target', 'month',
          'limitPaise', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'budgetType', 'target', 'month',
          'limitPaise', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.budgetType is string && data.budgetType in ['Monthly Overall', 'Service', 'Marketing', 'Team', 'Category'] && data.budgetType.size() <= 30
        && data.target is string && data.target.size() >= 1 && data.target.size() <= 160
        && isMonthString(data.month)
        && isPositiveInt(data.limitPaise)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFinanceAuditLog(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'entityType', 'entityId', 'action',
          'actorName', 'actorUid', 'timestampIso', 'oldValueSummary',
          'newValueSummary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'entityType', 'entityId', 'action',
          'actorName', 'actorUid', 'timestampIso', 'oldValueSummary',
          'newValueSummary', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.entityType is string && data.entityType in ['projectPayment', 'otherIncome', 'businessExpense'] && data.entityType.size() <= 30
        && data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 160
        && data.action is string && data.action in ['update', 'soft_delete', 'restore'] && data.action.size() <= 30
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.actorUid is string && isValidId(data.actorUid) && data.actorUid == request.auth.uid
        && data.timestampIso is string && data.timestampIso.size() >= 10 && data.timestampIso.size() <= 40
        && data.oldValueSummary is string && data.oldValueSummary.size() <= 1000
        && data.newValueSummary is string && data.newValueSummary.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidInAppNotification(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'type', 'title', 'message',
          'month', 'sourceId', 'read', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'type', 'title', 'message',
          'month', 'sourceId', 'read', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.type is string && data.type in ['budget_80', 'budget_100'] && data.type.size() <= 30
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && isMonthString(data.month)
        && data.sourceId is string && data.sourceId.size() >= 1 && data.sourceId.size() <= 128
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Phase 5A Entity Validation Blueprints (Competitor Discovery & Evidence)
    // -------------------------------------------------------------------------
    function isHttpUrl(val) {
      return val is string && val.size() >= 8 && val.size() <= 500 && val.matches('^https?://.+');
    }

    function isDataStatus(val) {
      return val is string && val in ['Verified', 'User Entered', 'Estimated', 'Unknown'] && val.size() <= 30;
    }

    function isEvidenceCategory(val) {
      return val is string && val in ['Services', 'Digital Presence', 'Technology', 'Business Evidence'] && val.size() <= 40;
    }

    function isValidCompetitor(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'companyName', 'marketLevel', 'classification',
          'foundedYear', 'pricingModel', 'targetAudience', 'threatLevel',
          'status', 'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'companyName', 'website', 'location',
          'marketLevel', 'classification', 'foundedYear', 'description',
          'industriesServed', 'primaryServices', 'pricingModel', 'targetAudience',
          'threatLevel', 'status', 'verificationStatus', 'isActiveTarget',
          'surpassedDate', 'surpassVerificationRunId', 'surpassPrevReviewId',
          'surpassCurrReviewId', 'nextReviewDate', 'lastVerifiedDate',
          'notes', 'seedKey', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160
        && (!('website' in data) || data.website == '' || (data.website is string && data.website.size() <= 300 && isHttpUrl(data.website)))
        && isOptionalString(data, 'location', 200)
        && data.marketLevel is string && data.marketLevel in ['Local', 'Tamil Nadu', 'India'] && data.marketLevel.size() <= 30
        && data.classification is string && data.classification in [
          'Direct Competitor', 'Indirect Competitor', 'Service-Specific Competitor',
          'Regional Benchmark', 'National Benchmark'
        ] && data.classification.size() <= 40
        && data.foundedYear is string && data.foundedYear.size() >= 1 && data.foundedYear.size() <= 20
        && isOptionalString(data, 'description', 1500)
        && (!('industriesServed' in data) || isStringList(data.industriesServed, 30))
        && (!('primaryServices' in data) || isStringList(data.primaryServices, 30))
        && data.pricingModel is string && data.pricingModel.size() >= 1 && data.pricingModel.size() <= 300
        && data.targetAudience is string && data.targetAudience.size() >= 1 && data.targetAudience.size() <= 300
        && data.threatLevel is string && data.threatLevel in ['Low', 'Medium', 'High', 'Unknown'] && data.threatLevel.size() <= 20
        && data.status is string && data.status in ['Active', 'Watching', 'Candidate', 'Inactive', 'Archived', 'Surpassed'] && data.status.size() <= 20
        && data.verificationStatus is string && data.verificationStatus in ['Unverified', 'Partially Verified', 'Verified'] && data.verificationStatus.size() <= 30
        && (!('isActiveTarget' in data) || data.isActiveTarget is bool)
        && (!('surpassedDate' in data) || data.surpassedDate == '' || isStrictDate(data.surpassedDate))
        && isOptionalString(data, 'surpassVerificationRunId', 128)
        && isOptionalString(data, 'surpassPrevReviewId', 128)
        && isOptionalString(data, 'surpassCurrReviewId', 128)
        && (!('nextReviewDate' in data) || data.nextReviewDate == '' || isStrictDate(data.nextReviewDate))
        && (!('lastVerifiedDate' in data) || data.lastVerifiedDate == '' || isStrictDate(data.lastVerifiedDate))
        && isOptionalString(data, 'notes', 2000)
        && isOptionalString(data, 'seedKey', 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitorMetric(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'competitorId', 'metricKey', 'metricName',
          'category', 'value', 'dataStatus', 'lastVerifiedDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'competitorId', 'metricKey', 'metricName',
          'category', 'value', 'serviceOfferStatus', 'rating', 'scorecardGroup',
          'sourceUrl', 'evidenceDescription', 'dataStatus', 'lastVerifiedDate',
          'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.competitorId is string && isValidId(data.competitorId)
        && data.metricKey is string && data.metricKey.size() >= 1 && data.metricKey.size() <= 80 && data.metricKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.metricName is string && data.metricName.size() >= 1 && data.metricName.size() <= 160
        && isEvidenceCategory(data.category)
        && data.value is string && data.value.size() >= 1 && data.value.size() <= 500
        && (!('serviceOfferStatus' in data) || (data.serviceOfferStatus is string && data.serviceOfferStatus in ['', 'Offered', 'Partially Offered', 'Not Offered', 'Unknown'] && data.serviceOfferStatus.size() <= 30))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('scorecardGroup' in data) || (data.scorecardGroup is string && data.scorecardGroup in ['', 'Market Presence', 'Business Performance'] && data.scorecardGroup.size() <= 30))
        && (!('sourceUrl' in data) || data.sourceUrl == '' || isHttpUrl(data.sourceUrl))
        && isOptionalString(data, 'evidenceDescription', 1500)
        && isDataStatus(data.dataStatus)
        && (data.dataStatus != 'Verified' || ('sourceUrl' in data && isHttpUrl(data.sourceUrl)))
        && (data.lastVerifiedDate == '' || isStrictDate(data.lastVerifiedDate))
        && isOptionalString(data, 'notes', 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitorEvidence(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'competitorId', 'category', 'metricName',
          'value', 'evidenceDescription', 'dataStatus', 'lastVerifiedDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'competitorId', 'metricId', 'metricKey',
          'category', 'metricName', 'value', 'sourceUrl', 'sourceTitle',
          'evidenceDescription', 'dataStatus', 'lastVerifiedDate', 'origin',
          'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.competitorId is string && isValidId(data.competitorId)
        && isOptionalString(data, 'metricId', 128)
        && isOptionalString(data, 'metricKey', 80)
        && isEvidenceCategory(data.category)
        && data.metricName is string && data.metricName.size() >= 1 && data.metricName.size() <= 160
        && data.value is string && data.value.size() >= 1 && data.value.size() <= 500
        && (!('sourceUrl' in data) || data.sourceUrl == '' || isHttpUrl(data.sourceUrl))
        && isOptionalString(data, 'sourceTitle', 200)
        && data.evidenceDescription is string && data.evidenceDescription.size() >= 1 && data.evidenceDescription.size() <= 1500
        && isDataStatus(data.dataStatus)
        && (data.dataStatus != 'Verified' || ('sourceUrl' in data && isHttpUrl(data.sourceUrl)))
        && (data.lastVerifiedDate == '' || isStrictDate(data.lastVerifiedDate))
        && (!('origin' in data) || (data.origin is string && data.origin in ['Manual', 'AI Accepted', 'AI Edited'] && data.origin.size() <= 30))
        && isOptionalString(data, 'notes', 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitorResearchHistory(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'competitorId', 'action', 'targetLabel',
          'runDate', 'status', 'groundingUsed', 'findingsCount',
          'acceptedCount', 'rejectedCount', 'createdAt', 'updatedAt'
        ])
