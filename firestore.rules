    // -------------------------------------------------------------------------
    // Phase 5A Collection Match Blocks (Competitor Discovery, Evidence & Research)
    // -------------------------------------------------------------------------
    match /competitors/{competitorId} {
      allow get: if isSignedIn() && isValidId(competitorId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(competitorId)
        && isValidCompetitor(incoming())
        && incoming().status != 'Surpassed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/companies/$(incoming().companyId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(competitorId)
        && isValidCompetitor(incoming())
        && isOwner(existing().ownerId)
        && existing().status != 'Surpassed'
        && incoming().ownerId == existing().ownerId
        && incoming().companyId == existing().companyId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            incoming().status != 'Surpassed'
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'companyName', 'website', 'location', 'marketLevel', 'classification',
                'foundedYear', 'description', 'industriesServed', 'primaryServices',
                'pricingModel', 'targetAudience', 'threatLevel', 'status', 'isActiveTarget',
                'verificationStatus', 'nextReviewDate', 'lastVerifiedDate', 'notes', 'updatedAt'
              ])
              || incoming().diff(existing()).affectedKeys().hasOnly([
                'verificationStatus', 'lastVerifiedDate', 'updatedAt'
              ])
              || incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'updatedAt'
              ])
              || incoming().diff(existing()).affectedKeys().hasOnly([
                'isActiveTarget', 'status', 'updatedAt'
              ])
              || incoming().diff(existing()).affectedKeys().hasOnly([
                'isActiveTarget', 'updatedAt'
              ])
            )
          )
          || (
            existing().isActiveTarget == true
            && incoming().status == 'Surpassed'
            && incoming().isActiveTarget == false
            && ('surpassedDate' in incoming()) && isStrictDate(incoming().surpassedDate)
            && ('surpassVerificationRunId' in incoming()) && isValidId(incoming().surpassVerificationRunId)
            && ('surpassPrevReviewId' in incoming()) && isValidId(incoming().surpassPrevReviewId)
            && ('surpassCurrReviewId' in incoming()) && isValidId(incoming().surpassCurrReviewId)
            && incoming().surpassPrevReviewId != incoming().surpassCurrReviewId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'isActiveTarget', 'surpassedDate', 'surpassVerificationRunId',
              'surpassPrevReviewId', 'surpassCurrReviewId', 'updatedAt'
            ])
            && existsAfter(/databases/$(database)/documents/rewardEvents/$('surpassed_' + competitorId))
            && existsAfter(/databases/$(database)/documents/competitorComparisons/$(incoming().surpassVerificationRunId))
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassPrevReviewId)).data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassPrevReviewId)).data.competitorId == competitorId
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassPrevReviewId)).data.eligibleForSurpass == true
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassPrevReviewId)).data.scoreAdvantage >= 10
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassCurrReviewId)).data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassCurrReviewId)).data.competitorId == competitorId
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassCurrReviewId)).data.eligibleForSurpass == true
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassCurrReviewId)).data.scoreAdvantage >= 10
            && get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassPrevReviewId)).data.month
              != get(/databases/$(database)/documents/competitorMonthlyReviews/$(incoming().surpassCurrReviewId)).data.month
          )
        );
      allow delete: if isSignedIn() && isValidId(competitorId) && isOwner(existing().ownerId);
    }

    match /competitorMetrics/{metricId} {
      allow get: if isSignedIn() && isValidId(metricId) && (resource == null || isOwner(existing().ownerId));
