    match /aiActionRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidAiActionRequest(incoming())
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/aiConversations/$(incoming().conversationId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidAiActionRequest(incoming())
        && isOwner(existing().ownerId)
        && existing().status == 'Pending'
        && incoming().status in ['Confirmed', 'Edited', 'Rejected', 'Executed', 'Expired']
        && incoming().ownerId == existing().ownerId
        && incoming().companyId == existing().companyId
        && incoming().conversationId == existing().conversationId
        && incoming().messageId == existing().messageId
        && incoming().actionType == existing().actionType
        && incoming().expiresAtIso == existing().expiresAtIso
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'payload', 'title', 'summary', 'status',
          'executedRecordId', 'executedRecordRoute', 'decisionNote', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(requestId) && isOwner(existing().ownerId);
    }

    match /aiUsage/{usageId} {
      allow get: if isSignedIn() && isValidId(usageId) && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
