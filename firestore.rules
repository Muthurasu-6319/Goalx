        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.competitorId is string && isValidId(data.competitorId)
        && data.competitorName is string && data.competitorName.size() >= 1 && data.competitorName.size() <= 160
        && data.snapshotKind is string && data.snapshotKind in ['comparison', 'surpassed_archive'] && data.snapshotKind.size() <= 30
        && (!('month' in data) || data.month == '' || isMonthString(data.month))
        && data.ownOverallScore is number && data.ownOverallScore >= 0 && data.ownOverallScore <= 100
        && data.competitorOverallScore is number && data.competitorOverallScore >= 0 && data.competitorOverallScore <= 100
        && data.ownMarketPresenceScore is number && data.ownMarketPresenceScore >= 0 && data.ownMarketPresenceScore <= 100
        && data.competitorMarketPresenceScore is number && data.competitorMarketPresenceScore >= 0 && data.competitorMarketPresenceScore <= 100
        && data.ownBusinessPerformanceScore is number && data.ownBusinessPerformanceScore >= 0 && data.ownBusinessPerformanceScore <= 100
        && data.competitorBusinessPerformanceScore is number && data.competitorBusinessPerformanceScore >= 0 && data.competitorBusinessPerformanceScore <= 100
        && isNonNegativeInt(data.comparableCount)
        && isNonNegativeInt(data.ownLeadCount)
        && isNonNegativeInt(data.competitorLeadCount)
        && isNonNegativeInt(data.equalCount)
        && isNonNegativeInt(data.missingCount)
        && data.scoreAdvantage is number && data.scoreAdvantage >= -100 && data.scoreAdvantage <= 100
        && (!('aheadMetrics' in data) || isStringList(data.aheadMetrics, 30))
        && (!('behindMetrics' in data) || isStringList(data.behindMetrics, 30))
        && (!('equalMetrics' in data) || isStringList(data.equalMetrics, 30))
        && (!('missingMetrics' in data) || isStringList(data.missingMetrics, 30))
        && isNonNegativeInt(data.gapsClosedCount)
        && isOptionalString(data, 'notes', 1500)
        && data.createdAt is timestamp;
    }

    function isValidCompetitorMonthlyReview(data, reviewId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'competitorId', 'month', 'version', 'reviewDate',
          'ownOverallScore', 'competitorOverallScore', 'scoreAdvantage',
          'ownMarketPresenceScore', 'competitorMarketPresenceScore',
          'ownBusinessPerformanceScore', 'competitorBusinessPerformanceScore',
          'comparableCount', 'ownLeadsCount', 'evidenceCoveragePct',
          'eligibleForSurpass', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'competitorId', 'month', 'version', 'reviewDate',
          'ownOverallScore', 'competitorOverallScore', 'scoreAdvantage',
          'ownMarketPresenceScore', 'competitorMarketPresenceScore',
          'ownBusinessPerformanceScore', 'competitorBusinessPerformanceScore',
          'comparableCount', 'ownLeadsCount', 'evidenceCoveragePct',
