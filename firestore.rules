        && data.category is string && data.category in ['Services', 'Digital Presence', 'Technology', 'Business Evidence', 'Candidate Discovery'] && data.category.size() <= 40
        && data.metricKey is string && data.metricKey.size() >= 1 && data.metricKey.size() <= 80 && data.metricKey.matches('^[a-zA-Z0-9_\\-]+$')
