          'ownerId', 'companyId', 'competitorId', 'action', 'targetLabel',
          'targetUrl', 'runDate', 'status', 'groundingUsed', 'summary',
          'searchQueries', 'sourceUrls', 'findingsCount', 'acceptedCount',
