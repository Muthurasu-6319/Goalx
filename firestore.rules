    // -------------------------------------------------------------------------
    // Phase 3B & Phase 4 Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidProject(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'title', 'clientId', 'budgetPaise',
          'status', 'startDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
