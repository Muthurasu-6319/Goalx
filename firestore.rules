        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && isOptionalString(data, 'description', 1500)
        && isPriorityLevel(data.priority)
        && data.status is string && data.status in ['Todo', 'In Progress', 'Done'] && data.status.size() <= 20
        && (!('dueDate' in data) || data.dueDate == '' || isStrictDate(data.dueDate))
        && data.sourceType is string && data.sourceType in ['manual', 'competitiveGap', 'aiProposal'] && data.sourceType.size() <= 30
        && isOptionalString(data, 'sourceId', 128)
        && isOptionalString(data, 'competitorId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRewardEvent(data, eventId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'type', 'competitorId', 'competitorName',
          'prevReviewId', 'currReviewId', 'scoreAdvantage', 'comparableCount',
          'achievedDate', 'xpAwarded', 'processedByPhase6', 'createdAt'
        ])
