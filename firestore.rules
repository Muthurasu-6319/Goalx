    }

    match /accountDeletionLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isOwner(existing().ownerId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidAccountDeletionLog(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 6A Gamification Server-Only Collections (Client Read-Only)
    // -------------------------------------------------------------------------
    match /xpTransactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(txId)
        && isValidXpTransaction(incoming(), txId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /userXp/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create, update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserXp(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /achievements/{achievementId} {
      allow get: if isSignedIn() && isValidId(achievementId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create, update: if isSignedIn()
        && isValidId(achievementId)
        && isValidAchievement(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }
