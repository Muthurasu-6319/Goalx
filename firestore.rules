        && data.minScoreAdvantage is number && data.minScoreAdvantage >= 10 && data.minScoreAdvantage <= 50
        && data.minEvidenceCoveragePct is int && data.minEvidenceCoveragePct >= 70 && data.minEvidenceCoveragePct <= 100
        && data.minConsecutiveMonths is int && data.minConsecutiveMonths >= 2 && data.minConsecutiveMonths <= 12
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitorComparison(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'competitorId', 'competitorName', 'snapshotKind',
          'ownOverallScore', 'competitorOverallScore', 'ownMarketPresenceScore',
          'competitorMarketPresenceScore', 'ownBusinessPerformanceScore',
          'competitorBusinessPerformanceScore', 'comparableCount', 'ownLeadCount',
