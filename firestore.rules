          'ownerId', 'companyId', 'type', 'competitorId', 'competitorName',
          'prevReviewId', 'currReviewId', 'scoreAdvantage', 'comparableCount',
          'achievedDate', 'xpAwarded', 'processedByPhase6', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.type == 'competitor_surpassed'
        && data.competitorId is string && isValidId(data.competitorId)
        && eventId == 'surpassed_' + data.competitorId
        && data.competitorName is string && data.competitorName.size() >= 1 && data.competitorName.size() <= 160
        && data.prevReviewId is string && isValidId(data.prevReviewId)
        && data.currReviewId is string && isValidId(data.currReviewId)
