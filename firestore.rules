    match /competitorPendingFindings/{findingId} {
      allow get: if isSignedIn() && isValidId(findingId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(findingId)
        && isValidCompetitorPendingFinding(incoming())
        && incoming().decision == 'Pending'
        && incoming().aiAssisted == true
        && incoming().dataStatus in ['Estimated', 'Unknown']
        && (!('reviewedAt' in incoming()) || incoming().reviewedAt == '')
        && (!('acceptedEvidenceId' in incoming()) || incoming().acceptedEvidenceId == '')
        && (!('createdCandidateId' in incoming()) || incoming().createdCandidateId == '')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/competitorResearchHistory/$(incoming().researchRunId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(findingId)
        && isValidCompetitorPendingFinding(incoming())
        && isOwner(existing().ownerId)
        && existing().decision == 'Pending'
        && incoming().decision in ['Accepted', 'Edited', 'Rejected']
        && incoming().ownerId == existing().ownerId
        && incoming().companyId == existing().companyId
        && incoming().researchRunId == existing().researchRunId
        && incoming().competitorId == existing().competitorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'decision', 'reviewedAt', 'reviewedValue', 'reviewedDataStatus',
          'reviewedNotes', 'acceptedEvidenceId', 'createdCandidateId', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(findingId) && isOwner(existing().ownerId);
    }

    // -------------------------------------------------------------------------
