    // -------------------------------------------------------------------------
    // Phase 7A Collection Match Blocks (Unified Notifications & Security Audit)
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().companyId == existing().companyId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(notificationId) && isOwner(existing().ownerId);
    }

    match /securityAuditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidSecurityAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
