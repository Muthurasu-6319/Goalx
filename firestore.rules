        && isValidAiUsage(incoming(), usageId)
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().companyId == existing().companyId
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'chatCount', 'briefingCount', 'baselineCount', 'updatedAt'
        ]);
      allow delete: if false;
