    function isValidAiMessage(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'conversationId', 'role', 'content',
          'areaTags', 'sources', 'aiUnavailable', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'conversationId', 'role', 'content',
          'areaTags', 'sources', 'aiUnavailable', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.conversationId is string && isValidId(data.conversationId)
        && data.role is string && data.role in ['user', 'assistant'] && data.role.size() <= 20
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 15000
        && isStringList(data.areaTags, 10)
        && data.sources is list && data.sources.size() <= 20 && (data.sources.size() == 0 || data.sources[0] is map)
        && data.aiUnavailable is bool
        && data.createdAt is timestamp;
    }

    function isValidAiBriefing(data, briefingId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'briefingType', 'date', 'greeting', 'overview',
          'sections', 'riskFlags', 'topPriority', 'mode', 'generatedAtIso',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'briefingType', 'date', 'greeting', 'overview',
          'sections', 'riskFlags', 'topPriority', 'mode', 'generatedAtIso',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.briefingType is string && data.briefingType in ['daily', 'weekly', 'monthly'] && data.briefingType.size() <= 20
        && isStrictDate(data.date)
        && briefingId.matches('^' + request.auth.uid + '_(briefing|weekly|monthly)_[0-9\\-]+$')
        && data.greeting is string && data.greeting.size() >= 1 && data.greeting.size() <= 200
        && data.overview is string && data.overview.size() <= 2000
        && data.sections is list && data.sections.size() <= 12 && (data.sections.size() == 0 || data.sections[0] is map)
        && isStringList(data.riskFlags, 20)
        && data.topPriority is string && data.topPriority.size() <= 500
        && data.mode is string && data.mode in ['ai', 'rule_based'] && data.mode.size() <= 20
        && data.generatedAtIso is string && data.generatedAtIso.size() >= 10 && data.generatedAtIso.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiActionRequest(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'conversationId', 'messageId', 'actionType',
          'title', 'summary', 'payload', 'status', 'expiresAtIso',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'conversationId', 'messageId', 'actionType',
          'title', 'summary', 'payload', 'status', 'expiresAtIso',
          'executedRecordId', 'executedRecordRoute', 'decisionNote',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.conversationId is string && isValidId(data.conversationId)
        && data.messageId is string && isValidId(data.messageId)
        && data.actionType is string
        && data.actionType in [
          'create_goal', 'create_task', 'create_calendar_event',
          'create_lead_followup', 'create_competitive_gap'
        ]
        && data.actionType.size() <= 40
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.summary is string && data.summary.size() <= 1000
        && data.payload is map
        && data.status is string
        && data.status in ['Pending', 'Confirmed', 'Edited', 'Rejected', 'Executed', 'Expired']
        && data.status.size() <= 20
        && data.expiresAtIso is string && data.expiresAtIso.size() >= 10 && data.expiresAtIso.size() <= 40
        && isOptionalString(data, 'executedRecordId', 128)
        && isOptionalString(data, 'executedRecordRoute', 200)
        && isOptionalString(data, 'decisionNote', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiUsage(data, usageId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'date', 'chatCount', 'briefingCount',
          'baselineCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'date', 'chatCount', 'briefingCount',
          'baselineCount', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && isStrictDate(data.date)
        && usageId == request.auth.uid + '_' + data.date
        && isNonNegativeInt(data.chatCount) && data.chatCount <= 50
        && isNonNegativeInt(data.briefingCount) && data.briefingCount <= 10
        && isNonNegativeInt(data.baselineCount) && data.baselineCount <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBaselineReview(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'reviewDate', 'monthsOfData', 'reliableBaseline',
          'warningMessage', 'summary', 'metrics', 'targets30Day', 'targets60Day',
          'targets90Day', 'suggestions', 'mode', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'reviewDate', 'monthsOfData', 'reliableBaseline',
          'warningMessage', 'summary', 'metrics', 'targets30Day', 'targets60Day',
          'targets90Day', 'suggestions', 'mode', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && isStrictDate(data.reviewDate)
        && isNonNegativeInt(data.monthsOfData) && data.monthsOfData <= 120
        && data.reliableBaseline is bool
        && data.warningMessage is string && data.warningMessage.size() <= 1000
        && data.summary is string && data.summary.size() <= 2000
        && data.metrics is list && data.metrics.size() <= 12 && (data.metrics.size() == 0 || data.metrics[0] is map)
        && isStringList(data.targets30Day, 10)
        && isStringList(data.targets60Day, 10)
        && isStringList(data.targets90Day, 10)
        && isStringList(data.suggestions, 15)
        && data.mode is string && data.mode in ['ai', 'rule_based'] && data.mode.size() <= 20
        && data.createdAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'actorType', 'action', 'targetType',
          'targetId', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'actorType', 'action', 'targetType',
          'targetId', 'summary', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.actorType is string && data.actorType in ['user', 'ai_ceo'] && data.actorType.size() <= 20
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 80
        && isOptionalString(data, 'targetId', 128)
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Phase 7A Entity Validation Blueprints (Unified Notifications & Security Audit)
    // -------------------------------------------------------------------------
    function isValidNotificationCategory(val) {
      return val is string && val in [
        'deadlines', 'projects', 'follow_ups', 'payments', 'goals',
        'habits', 'attendance', 'competitor_reviews', 'achievements',
        'targets', 'ai_proposals'
      ] && val.size() <= 30;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'category', 'type', 'severity',
          'title', 'message', 'link', 'sourceType', 'sourceId',
          'read', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'category', 'type', 'severity',
          'title', 'message', 'link', 'sourceType', 'sourceId',
          'read', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && isValidNotificationCategory(data.category)
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 60
        && data.severity is string && data.severity in ['info', 'warning', 'critical', 'success'] && data.severity.size() <= 20
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && data.link is string && data.link.size() >= 1 && data.link.size() <= 240 && data.link.matches('^/.*') && !data.link.matches('^//.*')
        && data.sourceType is string && data.sourceType.size() >= 1 && data.sourceType.size() <= 80
        && data.sourceId is string && data.sourceId.size() >= 1 && data.sourceId.size() <= 128
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecurityAuditLog(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'action', 'actorUid', 'actorName',
          'details', 'timestampIso', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'action', 'actorUid', 'actorName',
          'details', 'timestampIso', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.companyId is string && isValidId(data.companyId) && data.companyId == request.auth.uid
        && data.action is string && data.action in [
          'salary_view', 'salary_export', 'data_export', 'ai_history_delete',
          'module_delete', 'password_change', 'account_delete',
          'settings_security_change', 'financial_edit'
        ] && data.action.size() <= 40
        && data.actorUid is string && isValidId(data.actorUid) && data.actorUid == request.auth.uid
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 500
        && data.timestampIso is string && data.timestampIso.size() >= 10 && data.timestampIso.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidAccountDeletionLog(data) {
      return data.keys().hasAll([
          'ownerId', 'deletedCount', 'storageDeletedCount',
          'authDeleted', 'deletedAtIso', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'deletedCount', 'storageDeletedCount',
          'authDeleted', 'deletedAtIso', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && isNonNegativeInt(data.deletedCount)
        && isNonNegativeInt(data.storageDeletedCount)
        && data.authDeleted is bool
        && data.deletedAtIso is string && data.deletedAtIso.size() >= 10 && data.deletedAtIso.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidXpTransaction(data, txId) {
      return data.keys().hasAll([
          'ownerId', 'amount', 'reason', 'sourceType', 'sourceId', 'date', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'amount', 'reason', 'sourceType', 'sourceId', 'date', 'createdAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.amount is int && data.amount > 0 && data.amount <= 1000
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 200
        && data.sourceType is string && data.sourceType in [
          'task', 'habit', 'milestone', 'goal', 'project', 'lead',
          'target', 'competitor_review', 'gap_closed', 'competitor_surpassed', 'achievement'
        ]
        && data.sourceId is string && data.sourceId.size() >= 1 && data.sourceId.size() <= 128
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.createdAt is timestamp;
    }

    function isValidUserXp(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'totalXp', 'level', 'streakDays', 'totalTransactions', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'totalXp', 'level', 'streakDays', 'totalTransactions', 'lastAwardedAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && userId == request.auth.uid
        && isNonNegativeInt(data.totalXp)
        && data.level is int && data.level >= 1 && data.level <= 100
        && isNonNegativeInt(data.streakDays)
        && isNonNegativeInt(data.totalTransactions)
        && (
          !('lastAwardedAt' in data) ||
          (data.lastAwardedAt is string && data.lastAwardedAt.size() <= 40)
        )
        && data.updatedAt is timestamp;
    }

    function isValidAchievement(data) {
      return data.keys().hasAll([
          'ownerId', 'achievementKey', 'title', 'description', 'category',
          'iconName', 'rewardXp', 'unlockedAt', 'isUnlocked', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'achievementKey', 'title', 'description', 'category',
          'iconName', 'rewardXp', 'unlockedAt', 'isUnlocked', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.achievementKey is string && data.achievementKey.size() >= 1 && data.achievementKey.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 250
        && data.category is string && data.category in ['personal', 'business', 'competitor', 'mastery']
        && data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 64
        && isNonNegativeInt(data.rewardXp)
        && data.unlockedAt is string && data.unlockedAt.size() <= 40
        && data.isUnlocked is bool
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Phase 1 Collection Match Blocks
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'email', 'photoUrl', 'monthlyIncome', 'currency',
            'timezone', 'bio', 'personalGoals', 'onboardingCompleted', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'xp', 'level', 'streakDays', 'updatedAt'
          ])
        );
      allow delete: if isSignedIn() && isValidId(userId) && isOwner(existing().ownerId);
    }

    match /companies/{companyId} {
      allow get: if isSignedIn()
        && isValidId(companyId)
        && ((resource == null && isOwner(companyId)) || (resource != null && isOwner(existing().ownerId)));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(companyId)
        && isValidCompany(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(companyId)
        && isValidCompany(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'website', 'industry', 'services', 'location',
            'startDate', 'stage', 'goals', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'monthlyRevenue', 'activeProjectsCount', 'competitorsTrackedCount', 'updatedAt'
          ])
        );
      allow delete: if isSignedIn() && isValidId(companyId) && isOwner(existing().ownerId);
    }

    match /settings/{settingId} {
      allow get: if isSignedIn()
        && isValidId(settingId)
        && ((resource == null && isOwner(settingId)) || (resource != null && isOwner(existing().ownerId)));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(settingId)
        && isOwner(settingId)
        && isValidSettings(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(settingId)
        && isValidSettings(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'theme', 'density', 'reducedMotion', 'notificationsEnabled',
          'emailDigest', 'browserPushEnabled', 'notificationPrefs',
          'weekStartsOn', 'currency', 'currencyFormat', 'accountingBasis',
          'timezone', 'sidebarCollapsed', 'defaultCommissionPct',
          'customExpenseCategories', 'gamificationConfig', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(settingId) && isOwner(existing().ownerId);
    }

    // -------------------------------------------------------------------------
    // Phase 2 Collection Match Blocks
    // -------------------------------------------------------------------------
    match /goals/{goalId} {
      allow get: if isSignedIn() && isValidId(goalId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(goalId)
        && isValidGoal(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(goalId)
        && isValidGoal(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'category', 'startDate', 'targetDate',
            'priority', 'goalType', 'targetValue', 'unit', 'notes', 'status', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'currentValue', 'status', 'updatedAt'
          ])
        );
      allow delete: if isSignedIn() && isValidId(goalId) && isOwner(existing().ownerId);
    }

    match /milestones/{milestoneId} {
      allow get: if isSignedIn() && isValidId(milestoneId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(milestoneId)
        && isValidMilestone(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/goals/$(incoming().goalId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(milestoneId)
        && isValidMilestone(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().goalId == existing().goalId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'completed', 'order', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(milestoneId) && isOwner(existing().ownerId);
    }

    match /goalProgressHistory/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(entryId)
        && isValidGoalProgressEntry(incoming())
        && incoming().createdAt == request.time
        && get(/databases/$(database)/documents/goals/$(incoming().goalId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(entryId) && isOwner(existing().ownerId);
    }

    match /habits/{habitId} {
      allow get: if isSignedIn() && isValidId(habitId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(habitId)
        && isValidHabit(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(habitId)
        && isValidHabit(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'icon', 'scheduleType', 'weekdays', 'weeklyTarget',
          'reminderTime', 'active', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(habitId) && isOwner(existing().ownerId);
    }

    match /habitLogs/{logId} {
      allow get: if isSignedIn()
        && isValidId(logId)
        && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidHabitLog(incoming(), logId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/habits/$(incoming().habitId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(logId)
        && isValidHabitLog(incoming(), logId)
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().habitId == existing().habitId
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(logId) && isOwner(existing().ownerId);
    }

    match /incomes/{incomeId} {
      allow get: if isSignedIn() && isValidId(incomeId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(incomeId)
        && isValidIncome(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(incomeId)
        && isValidIncome(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'source', 'type', 'amountPaise', 'date', 'notes', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(incomeId) && isOwner(existing().ownerId);
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && isValidId(expenseId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'category', 'amountPaise', 'date', 'paymentMethod', 'notes', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(expenseId) && isOwner(existing().ownerId);
    }

    match /savingsGoals/{savingsGoalId} {
      allow get: if isSignedIn() && isValidId(savingsGoalId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(savingsGoalId)
        && isValidSavingsGoal(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(savingsGoalId)
        && isValidSavingsGoal(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'targetAmountPaise', 'targetDate', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(savingsGoalId) && isOwner(existing().ownerId);
    }

    match /savingsTransactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
