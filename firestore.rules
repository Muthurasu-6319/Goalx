      allow update: if false;
      allow delete: if isSignedIn() && isValidId(messageId) && isOwner(existing().ownerId);
    }

    match /aiBriefings/{briefingId} {
      allow get: if isSignedIn() && isValidId(briefingId) && (resource == null || isOwner(existing().ownerId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(briefingId)
