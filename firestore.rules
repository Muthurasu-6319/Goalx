rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all paths unless explicitly permitted below
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || data[key] == null || (data[key] is number && data[key] >= 0);
    }

    function isDateString(val) {
      return val is string && val.size() >= 8 && val.size() <= 20;
    }

    function isStrictDate(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isMonthString(val) {
      return val is string && val.size() == 7 && val.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isPositiveInt(val) {
      return val is int && val > 0;
    }

    function isNonNegativeInt(val) {
      return val is int && val >= 0;
    }

    function isPaymentMethod(val) {
      return val is string && val in ['Cash', 'UPI', 'Bank Transfer', 'Cheque', 'Card', 'Other'] && val.size() <= 30;
    }

    function isStringList(listVal, maxItems) {
      return listVal is list
        && listVal.size() <= maxItems
        && (listVal.size() == 0 || (listVal.size() > 0 && listVal[0] is string && listVal[0].size() <= 160));
    }

    function isWeekdayList(listVal) {
      return listVal is list
        && listVal.size() <= 7
        && (listVal.size() == 0 || (listVal.size() > 0 && listVal[0] is number && listVal[0] >= 0 && listVal[0] <= 6));
    }

    // -------------------------------------------------------------------------
    // Phase 1 Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUser(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'email', 'onboardingCompleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'name', 'email', 'photoUrl', 'monthlyIncome', 'currency',
          'timezone', 'bio', 'personalGoals', 'onboardingCompleted',
          'xp', 'level', 'streakDays', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && isOptionalString(data, 'photoUrl', 1000)
        && isOptionalNumber(data, 'monthlyIncome')
        && isOptionalString(data, 'currency', 10)
        && isOptionalString(data, 'timezone', 80)
        && isOptionalString(data, 'bio', 500)
        && (!('personalGoals' in data) || isStringList(data.personalGoals, 20))
        && data.onboardingCompleted is bool
        && (!('xp' in data) || (data.xp is number && data.xp >= 0 && data.xp <= 10000000))
        && (!('level' in data) || (data.level is number && data.level >= 1 && data.level <= 1000))
        && (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompany(data) {
      return data.keys().hasAll(['ownerId', 'name', 'industry', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'name', 'website', 'industry', 'services', 'location',
          'startDate', 'stage', 'goals', 'monthlyRevenue', 'activeProjectsCount',
          'competitorsTrackedCount', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && isOptionalString(data, 'website', 300)
        && data.industry is string
        && data.industry.size() >= 1
        && data.industry.size() <= 160
        && (!('services' in data) || isStringList(data.services, 30))
        && isOptionalString(data, 'location', 300)
        && isOptionalString(data, 'startDate', 40)
        && isOptionalString(data, 'stage', 80)
        && (!('goals' in data) || isStringList(data.goals, 20))
        && isOptionalNumber(data, 'monthlyRevenue')
        && isOptionalNumber(data, 'activeProjectsCount')
        && isOptionalNumber(data, 'competitorsTrackedCount')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotificationPrefsMap(prefs) {
      return prefs is map
        && prefs.keys().hasAll(['categories', 'quietHoursEnabled', 'quietHoursStart', 'quietHoursEnd'])
        && prefs.keys().hasOnly(['categories', 'quietHoursEnabled', 'quietHoursStart', 'quietHoursEnd'])
        && prefs.categories is map
        && prefs.categories.keys().hasAll([
          'deadlines', 'projects', 'follow_ups', 'payments', 'goals',
          'habits', 'attendance', 'competitor_reviews', 'achievements',
          'targets', 'ai_proposals'
        ])
        && prefs.categories.keys().hasOnly([
          'deadlines', 'projects', 'follow_ups', 'payments', 'goals',
          'habits', 'attendance', 'competitor_reviews', 'achievements',
          'targets', 'ai_proposals'
        ])
        && prefs.categories.deadlines is bool
        && prefs.categories.projects is bool
        && prefs.categories.follow_ups is bool
        && prefs.categories.payments is bool
        && prefs.categories.goals is bool
        && prefs.categories.habits is bool
        && prefs.categories.attendance is bool
        && prefs.categories.competitor_reviews is bool
        && prefs.categories.achievements is bool
        && prefs.categories.targets is bool
        && prefs.categories.ai_proposals is bool
        && prefs.quietHoursEnabled is bool
        && prefs.quietHoursStart is string && prefs.quietHoursStart.size() == 5 && prefs.quietHoursStart.matches('^[0-9]{2}:[0-9]{2}$')
        && prefs.quietHoursEnd is string && prefs.quietHoursEnd.size() == 5 && prefs.quietHoursEnd.matches('^[0-9]{2}:[0-9]{2}$');
    }

    function isValidGamificationConfigMap(cfg) {
      return cfg is map
        && cfg.keys().hasAll([
          'taskComplete', 'goalComplete', 'milestoneComplete', 'habitCheckIn',
          'projectComplete', 'clientWon', 'competitorSurpassed', 'monthlyReviewSaved'
        ])
        && cfg.keys().hasOnly([
          'taskComplete', 'goalComplete', 'milestoneComplete', 'habitCheckIn',
          'projectComplete', 'clientWon', 'competitorSurpassed', 'monthlyReviewSaved'
        ])
        && isNonNegativeInt(cfg.taskComplete) && cfg.taskComplete <= 5000
        && isNonNegativeInt(cfg.goalComplete) && cfg.goalComplete <= 5000
        && isNonNegativeInt(cfg.milestoneComplete) && cfg.milestoneComplete <= 5000
        && isNonNegativeInt(cfg.habitCheckIn) && cfg.habitCheckIn <= 5000
        && isNonNegativeInt(cfg.projectComplete) && cfg.projectComplete <= 5000
        && isNonNegativeInt(cfg.clientWon) && cfg.clientWon <= 5000
        && isNonNegativeInt(cfg.competitorSurpassed) && cfg.competitorSurpassed <= 10000
        && isNonNegativeInt(cfg.monthlyReviewSaved) && cfg.monthlyReviewSaved <= 5000;
    }

    function isValidSettings(data) {
      return data.keys().hasAll([
          'ownerId', 'theme', 'notificationsEnabled', 'emailDigest',
          'weekStartsOn', 'currency', 'sidebarCollapsed', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'theme', 'density', 'reducedMotion',
          'notificationsEnabled', 'emailDigest', 'browserPushEnabled', 'notificationPrefs',
          'weekStartsOn', 'currency', 'currencyFormat', 'accountingBasis', 'timezone',
          'sidebarCollapsed', 'defaultCommissionPct', 'customExpenseCategories',
          'gamificationConfig', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.theme is string
        && data.theme in ['light', 'dark']
        && data.theme.size() <= 20
        && (!('density' in data) || (data.density is string && data.density in ['comfortable', 'compact'] && data.density.size() <= 20))
        && (!('reducedMotion' in data) || data.reducedMotion is bool)
        && data.notificationsEnabled is bool
        && data.emailDigest is bool
        && (!('browserPushEnabled' in data) || data.browserPushEnabled is bool)
        && (!('notificationPrefs' in data) || isValidNotificationPrefsMap(data.notificationPrefs))
        && data.weekStartsOn is string
        && data.weekStartsOn in ['monday', 'sunday']
        && data.weekStartsOn.size() <= 20
        && data.currency is string
        && data.currency.size() >= 1
        && data.currency.size() <= 10
        && (!('currencyFormat' in data) || (data.currencyFormat is string && data.currencyFormat in ['indian', 'standard'] && data.currencyFormat.size() <= 20))
        && (!('accountingBasis' in data) || (data.accountingBasis is string && data.accountingBasis in ['cash', 'accrual'] && data.accountingBasis.size() <= 20))
        && isOptionalString(data, 'timezone', 80)
        && data.sidebarCollapsed is bool
        && (!('defaultCommissionPct' in data) || (data.defaultCommissionPct is number && data.defaultCommissionPct >= 0 && data.defaultCommissionPct <= 100))
        && (!('customExpenseCategories' in data) || isStringList(data.customExpenseCategories, 30))
        && (!('gamificationConfig' in data) || isValidGamificationConfigMap(data.gamificationConfig))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Phase 2 Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidGoal(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'category', 'startDate', 'targetDate',
          'priority', 'goalType', 'targetValue', 'currentValue', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'description', 'category', 'startDate', 'targetDate',
          'priority', 'goalType', 'targetValue', 'currentValue', 'unit', 'notes',
          'status', 'sourceType', 'sourceId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && isOptionalString(data, 'description', 1000)
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 80
        && isDateString(data.startDate)
        && isDateString(data.targetDate)
        && data.priority is string
        && data.priority in ['Low', 'Medium', 'High']
        && data.priority.size() <= 20
        && data.goalType is string
        && data.goalType in [
          'Numeric', 'Financial', 'Percentage', 'Task-based',
          'Time-based', 'Learning', 'Custom measurable'
        ]
        && data.goalType.size() <= 40
        && data.targetValue is number
        && data.targetValue > 0
        && data.currentValue is number
        && data.currentValue >= 0
        && isOptionalString(data, 'unit', 40)
        && isOptionalString(data, 'notes', 2000)
        && data.status is string
        && data.status in ['Not Started', 'In Progress', 'Completed', 'Delayed', 'Archived']
        && data.status.size() <= 30
        && (!('sourceType' in data) || (data.sourceType is string && data.sourceType in ['', 'competitiveGap', 'aiProposal'] && data.sourceType.size() <= 30))
        && isOptionalString(data, 'sourceId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMilestone(data) {
      return data.keys().hasAll(['ownerId', 'goalId', 'title', 'completed', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'goalId', 'title', 'completed', 'order', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.goalId is string
        && isValidId(data.goalId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.completed is bool
        && data.order is number
        && data.order >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoalProgressEntry(data) {
      return data.keys().hasAll(['ownerId', 'goalId', 'value', 'delta', 'date', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'goalId', 'value', 'delta', 'date', 'note', 'createdAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.goalId is string
        && isValidId(data.goalId)
        && data.value is number
        && data.value >= 0
        && data.delta is number
        && isDateString(data.date)
        && isOptionalString(data, 'note', 500)
        && data.createdAt is timestamp;
    }

    function isValidHabit(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'icon', 'scheduleType', 'weekdays',
          'weeklyTarget', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'icon', 'scheduleType', 'weekdays',
          'weeklyTarget', 'reminderTime', 'active', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.icon is string
        && data.icon.size() >= 1
        && data.icon.size() <= 40
        && data.scheduleType is string
        && data.scheduleType in ['daily', 'weekdays', 'weekly_target']
        && data.scheduleType.size() <= 30
        && isWeekdayList(data.weekdays)
        && data.weeklyTarget is number
        && data.weeklyTarget >= 1
        && data.weeklyTarget <= 7
        && isOptionalString(data, 'reminderTime', 20)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHabitLog(data, logId) {
      return data.keys().hasAll(['ownerId', 'habitId', 'date', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'habitId', 'date', 'completed', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.habitId is string
        && isValidId(data.habitId)
        && isDateString(data.date)
        && logId == data.habitId + '_' + data.date
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIncome(data) {
      return data.keys().hasAll(['ownerId', 'source', 'type', 'amountPaise', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'source', 'type', 'amountPaise', 'date', 'notes', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.source is string
        && data.source.size() >= 1
        && data.source.size() <= 160
        && data.type is string
        && data.type in ['Salary', 'Freelance', 'Business', 'Other']
        && data.type.size() <= 30
        && data.amountPaise is number
        && data.amountPaise >= 0
        && isDateString(data.date)
        && isOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['ownerId', 'category', 'amountPaise', 'date', 'paymentMethod', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'category', 'amountPaise', 'date', 'paymentMethod', 'notes', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 80
        && data.amountPaise is number
        && data.amountPaise >= 0
        && isDateString(data.date)
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 60
        && isOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavingsGoal(data) {
      return data.keys().hasAll(['ownerId', 'name', 'targetAmountPaise', 'targetDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'targetAmountPaise', 'targetDate', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.targetAmountPaise is number
        && data.targetAmountPaise > 0
        && isDateString(data.targetDate)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavingsTransaction(data) {
      return data.keys().hasAll(['ownerId', 'savingsGoalId', 'type', 'amountPaise', 'date', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'savingsGoalId', 'type', 'amountPaise', 'date', 'notes', 'createdAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.savingsGoalId is string
        && isValidId(data.savingsGoalId)
        && data.type is string
        && data.type in ['deposit', 'withdraw']
        && data.type.size() <= 20
        && data.amountPaise is number
        && data.amountPaise > 0
        && isDateString(data.date)
        && isOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'eventType', 'date', 'allDay',
          'sourceType', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'eventType', 'date', 'startTime', 'endTime',
          'allDay', 'notes', 'reminderMinutes', 'sourceType', 'sourceId',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.eventType is string
        && data.eventType in [
          'Personal Event', 'Goal Deadline', 'Habit Reminder',
          'Project Deadline', 'Client Follow-up', 'Payment Due',
          'Team Meeting', 'Competitor Review', 'Gap Deadline',
          'Monthly Competitor Review'
        ]
        && data.eventType.size() <= 50
        && isDateString(data.date)
        && isOptionalString(data, 'startTime', 10)
        && isOptionalString(data, 'endTime', 10)
        && data.allDay is bool
        && isOptionalString(data, 'notes', 1000)
        && isOptionalNumber(data, 'reminderMinutes')
        && data.sourceType is string
        && data.sourceType in ['manual', 'goal', 'habit', 'lead', 'project', 'client', 'payment', 'invoice', 'meeting', 'competitor', 'competitiveGap', 'aiProposal']
        && data.sourceType.size() <= 30
        && isOptionalString(data, 'sourceId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Phase 3A Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidBusinessService(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'name', 'startingPricePaise',
          'estimatedDeliveryDays', 'status', 'subServices', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'name', 'description', 'startingPricePaise',
          'estimatedDeliveryDays', 'status', 'subServices', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.companyId is string
        && isValidId(data.companyId)
        && data.companyId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && isOptionalString(data, 'description', 1000)
        && data.startingPricePaise is number
        && data.startingPricePaise >= 0
        && data.estimatedDeliveryDays is number
        && data.estimatedDeliveryDays >= 0
        && data.estimatedDeliveryDays <= 3650
        && data.status is string
        && data.status in ['Active', 'Planned', 'Inactive']
        && data.status.size() <= 20
        && isStringList(data.subServices, 30)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLead(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'clientName', 'serviceCategory', 'leadSource',
          'leadGeneratedDate', 'estimatedBudgetPaise', 'status', 'archived',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'clientName', 'businessName', 'phone', 'email',
          'location', 'requirement', 'serviceId', 'serviceCategory', 'leadSource',
          'leadGeneratedDate', 'assignedPerson', 'estimatedBudgetPaise',
          'followUpDate', 'notes', 'status', 'lostReason', 'archived',
          'convertedClientId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.companyId is string
        && isValidId(data.companyId)
        && data.companyId == request.auth.uid
        && data.clientName is string
        && data.clientName.size() >= 1
        && data.clientName.size() <= 160
        && isOptionalString(data, 'businessName', 160)
        && isOptionalString(data, 'phone', 30)
        && isOptionalString(data, 'email', 200)
        && isOptionalString(data, 'location', 200)
        && isOptionalString(data, 'requirement', 2000)
        && isOptionalString(data, 'serviceId', 128)
        && data.serviceCategory is string
        && data.serviceCategory.size() >= 1
        && data.serviceCategory.size() <= 160
        && data.leadSource is string
        && data.leadSource in [
          'Meta Ads', 'Direct', 'Referral', 'Telecalling',
          'Website', 'Repeat Client', 'Social Media', 'Other'
        ]
        && data.leadSource.size() <= 40
        && isDateString(data.leadGeneratedDate)
        && isOptionalString(data, 'assignedPerson', 120)
        && data.estimatedBudgetPaise is number
        && data.estimatedBudgetPaise >= 0
        && (!('followUpDate' in data) || data.followUpDate == '' || isDateString(data.followUpDate))
        && isOptionalString(data, 'notes', 2000)
        && data.status is string
        && data.status in [
          'New', 'Contacted', 'Interested', 'Follow-up',
          'Proposal Sent', 'Negotiation', 'Won', 'Lost'
        ]
        && data.status.size() <= 30
        && isOptionalString(data, 'lostReason', 500)
        && (data.status != 'Lost' || ('lostReason' in data && data.lostReason is string && data.lostReason.size() >= 1 && data.lostReason.size() <= 500))
        && data.archived is bool
        && isOptionalString(data, 'convertedClientId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeadActivity(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'leadId', 'fromStatus',
          'toStatus', 'date', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'leadId', 'fromStatus',
          'toStatus', 'date', 'note', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.companyId is string
        && isValidId(data.companyId)
        && data.companyId == request.auth.uid
        && data.leadId is string
        && isValidId(data.leadId)
        && data.fromStatus is string
        && data.fromStatus.size() <= 40
        && data.toStatus is string
        && data.toStatus in [
          'New', 'Contacted', 'Interested', 'Follow-up',
          'Proposal Sent', 'Negotiation', 'Won', 'Lost'
        ]
        && data.toStatus.size() <= 30
        && isDateString(data.date)
        && isOptionalString(data, 'note', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeadNote(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'leadId', 'channel',
          'date', 'text', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'leadId', 'channel',
          'date', 'text', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.companyId is string
        && isValidId(data.companyId)
        && data.companyId == request.auth.uid
        && data.leadId is string
        && isValidId(data.leadId)
        && data.channel is string
        && data.channel in ['call', 'whatsapp', 'email', 'meeting', 'note']
        && data.channel.size() <= 20
        && isDateString(data.date)
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClient(data) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'clientName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'clientName', 'company', 'phone', 'email',
          'address', 'sourceLeadId', 'serviceId', 'serviceCategory',
          'clientManager', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.companyId is string
        && isValidId(data.companyId)
        && data.companyId == request.auth.uid
        && data.clientName is string
        && data.clientName.size() >= 1
        && data.clientName.size() <= 160
        && isOptionalString(data, 'company', 160)
        && isOptionalString(data, 'phone', 30)
        && isOptionalString(data, 'email', 200)
        && isOptionalString(data, 'address', 500)
        && isOptionalString(data, 'sourceLeadId', 128)
        && isOptionalString(data, 'serviceId', 128)
        && isOptionalString(data, 'serviceCategory', 160)
        && isOptionalString(data, 'clientManager', 120)
        && isOptionalString(data, 'notes', 2000)
        && data.status is string
        && data.status in ['Active', 'Inactive', 'Recurring']
        && data.status.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
